// M3M Perform — pilot schema.
//
// The shape follows the design document: a published KPI set carries weights and
// monthly targets, leads log actuals against them each cycle, the cycle locks,
// and everything that touches the record is stamped with who did it and why.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // Pooled connection for the app; migrations need the direct one.
  url       = env("m3m_internal_tools_DATABASE_URL")
  directUrl = env("m3m_internal_tools_DATABASE_URL_UNPOOLED")
}

// ---------------------------------------------------------------------------
// People and access
// ---------------------------------------------------------------------------

enum Role {
  EMPLOYEE
  MANAGER
  HR
}

model Department {
  id        String     @id @default(cuid())
  name      String     @unique
  headName  String?
  employees Employee[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Employee {
  /// The M3M employee number, e.g. EMP-10233. Used everywhere as the identifier
  /// because names repeat — there are three Rohit Vermas.
  id           String     @id
  name         String
  title        String
  location     String?
  joinedOn     DateTime?
  active       Boolean    @default(true)
  departmentId String
  department   Department @relation(fields: [departmentId], references: [id])

  /// The lead this person reports to. Self-relation: a lead is an Employee too.
  leadId String?
  lead   Employee?  @relation("TeamMembers", fields: [leadId], references: [id])
  team   Employee[] @relation("TeamMembers")

  user             User?
  kpis             Kpi[]
  entries          MonthlyEntry[]
  submissions      Submission[]
  annualReviews    AnnualReview[]
  exceptionsRaised ExceptionRequest[] @relation("ExceptionSubject")
  activity         ActivityLog[]      @relation("ActivitySubject")
  acknowledgements Acknowledgement[]
  queries          MonthQuery[]
  corrections      CorrectionRequest[] @relation("CorrectionSubject")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([leadId])
  @@index([departmentId])
}

model User {
  id    String @id @default(cuid())
  email String @unique
  role  Role   @default(MANAGER)

  /// Null until the person sets a password on first login. Seeded users start
  /// null: HR creates the account, the employee chooses the secret.
  passwordHash    String?
  mustSetPassword Boolean   @default(true)
  lastLoginAt     DateTime?

  employeeId String   @unique
  employee   Employee @relation(fields: [employeeId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// The KPI master and the monthly cycle
// ---------------------------------------------------------------------------

/// A month in a financial year. Nothing can be logged against a cycle that is
/// not OPEN; nothing can be edited once it is LOCKED.
enum CycleState {
  FUTURE
  OPEN
  LOCKED
}

model Cycle {
  id String @id @default(cuid())

  /// Financial year label, e.g. "2025-26".
  fiscalYear String
  /// 1 = April, 12 = March. The year strip always renders all twelve.
  monthIndex Int
  /// Display label, e.g. "February 2026".
  label      String

  state    CycleState @default(FUTURE)
  opensOn  DateTime?
  locksOn  DateTime?
  lockedAt DateTime?

  entries          MonthlyEntry[]
  submissions      Submission[]
  uploads          UploadBatch[]
  activity         ActivityLog[]
  acknowledgements Acknowledgement[]
  queries          MonthQuery[]
  corrections      CorrectionRequest[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([fiscalYear, monthIndex])
  @@index([state])
}

/// How a KPI's actual is judged. `lowerIsBetter` is what the achievement maths
/// actually branches on; `type` is the richer classification captured at
/// seed time (from the roster/KPI sheet) and kept in sync with it — milestone
/// and qualitative KPIs behave like HIGHER_IS_BETTER today (actual ÷ target),
/// since neither the entry form nor the achievement maths has a distinct
/// input mode for them yet.
enum KpiType {
  HIGHER_IS_BETTER
  LOWER_IS_BETTER
  MILESTONE
  QUALITATIVE
}

/// One key result area for one employee for one financial year. Weights across
/// an employee's *currently active* KPIs sum to 100.
///
/// Effective-dated: editing a KPI never mutates a row a month has already been
/// scored against. Instead the old row is closed out (`effectiveTo` set) and a
/// new row picks up from the next editable month (`effectiveFrom`). A row with
/// `effectiveTo: null` is either the live set (`effectiveFrom` at or before the
/// current cycle) or a pending edit not yet in force (`effectiveFrom` in the
/// future) — see lib/kpi.ts, the one place that draws that line.
model Kpi {
  id         String   @id @default(cuid())
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  /// Stable across versions of the same KRA — the first version's own `id`,
  /// carried forward unchanged every time an edit closes one row and opens
  /// the next. What lets the Scorecard matrix find a locked month's entry
  /// (recorded against whichever version was live that month) even after the
  /// KRA has since been renamed or reweighted. A brand new KRA's first
  /// version sets this to its own `id`.
  lineageId String

  fiscalYear String
  name       String
  /// Unit and provenance, shown under the name on the entry form.
  basis      String
  unit       String?

  weight Decimal @db.Decimal(5, 2)
  target Decimal @db.Decimal(14, 2)

  type KpiType @default(HIGHER_IS_BETTER)
  /// TAT and escalation KPIs invert the achievement maths: target / actual.
  /// Derived from `type` at write time — `type === LOWER_IS_BETTER`.
  lowerIsBetter Boolean @default(false)
  sortOrder     Int     @default(0)

  /// 1–12, the fiscalYear month this version starts applying from.
  effectiveFrom Int @default(1)
  /// 1–12, the last month this version applies to. Null = still active.
  effectiveTo   Int?

  entries MonthlyEntry[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([employeeId, fiscalYear, name, effectiveFrom])
  @@index([employeeId, fiscalYear])
  @@index([employeeId, fiscalYear, effectiveTo])
  @@index([employeeId, fiscalYear, lineageId])
}

/// One actual, for one KPI, in one cycle. This is the row a lead types into.
model MonthlyEntry {
  id String @id @default(cuid())

  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  cycleId    String
  cycle      Cycle    @relation(fields: [cycleId], references: [id])
  kpiId      String
  kpi        Kpi      @relation(fields: [kpiId], references: [id], onDelete: Cascade)

  actual Decimal? @db.Decimal(14, 2)

  /// Required when achievement lands outside 70–120%. Carried into the annual
  /// review verbatim — this is the evidence the appraisal is built on.
  contextNote String?

  /// Snapshot of achievement at save time, so a later target correction cannot
  /// silently rewrite history.
  achievement Decimal? @db.Decimal(7, 2)

  updatedById String?
  updatedAt   DateTime @updatedAt
  createdAt   DateTime @default(now())

  @@unique([kpiId, cycleId])
  @@index([employeeId, cycleId])
}

/// A person confirming they've seen their record for a cycle — distinct from
/// submitting it, and from HR's `RATING_SUBMITTED` events. Nothing creates one
/// yet; the "confirm you've seen this" action is a different screen's job,
/// same as ExceptionRequest and CorrectionRequest below have models ahead of
/// their UI.
model Acknowledgement {
  id             String   @id @default(cuid())
  employeeId     String
  employee       Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  cycleId        String
  cycle          Cycle    @relation(fields: [cycleId], references: [id])
  acknowledgedAt DateTime @default(now())

  @@unique([employeeId, cycleId])
  @@index([employeeId])
}

enum QueryState {
  OPEN
  ANSWERED
}

/// An employee asking about a specific month's record. Routes to their
/// manager, not HR — both the question and the answer are the evidence trail,
/// same reasoning as MonthlyEntry.contextNote.
model MonthQuery {
  id String @id @default(cuid())

  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  cycleId    String
  cycle      Cycle    @relation(fields: [cycleId], references: [id])

  question String
  askedAt  DateTime @default(now())

  state         QueryState @default(OPEN)
  response      String?
  respondedById String?
  respondedAt   DateTime?

  @@index([employeeId])
  @@index([state])
}

enum SubmissionState {
  DRAFT
  SUBMITTED
  SUPERSEDED
}

enum EntrySource {
  FORM
  UPLOAD
}

/// A lead committing an employee's month. Superseded rather than overwritten,
/// so the history of what was claimed when survives.
model Submission {
  id String @id @default(cuid())

  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  cycleId    String
  cycle      Cycle    @relation(fields: [cycleId], references: [id])

  weightedScore Decimal?        @db.Decimal(7, 2)
  state         SubmissionState @default(DRAFT)
  source        EntrySource     @default(FORM)

  submittedAt   DateTime?
  submittedById String?

  supersedesId String?     @unique
  supersedes   Submission? @relation("SubmissionChain", fields: [supersedesId], references: [id])
  supersededBy Submission? @relation("SubmissionChain")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([employeeId, cycleId, state])
  @@index([cycleId, state])
}

// ---------------------------------------------------------------------------
// The annual rating
// ---------------------------------------------------------------------------

enum ReviewState {
  NOT_STARTED
  DRAFT
  SUBMITTED
  CALIBRATED
}

model AnnualReview {
  id String @id @default(cuid())

  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  fiscalYear String

  yearAverage  Decimal? @db.Decimal(7, 2)
  monthsLogged Int      @default(0)

  /// 1–5. impliedBand comes from the record; chosenBand is the lead's call.
  impliedBand Int?
  chosenBand  Int?

  /// Required when chosenBand is two or more bands from impliedBand.
  justification    String?
  reviewerComment  String?

  state         ReviewState @default(NOT_STARTED)
  submittedAt   DateTime?
  submittedById String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([employeeId, fiscalYear])
}

// ---------------------------------------------------------------------------
// Things that need a human decision
// ---------------------------------------------------------------------------

enum RequestState {
  PENDING
  APPROVED
  REJECTED
}

enum ExceptionType {
  BACK_ENTRY
  WEIGHT_CHANGE
  TARGET_RESET
  OTHER
}

model ExceptionRequest {
  id String @id @default(cuid())

  employeeId String
  employee   Employee @relation("ExceptionSubject", fields: [employeeId], references: [id], onDelete: Cascade)

  type   ExceptionType
  detail String

  raisedById String
  raisedAt   DateTime @default(now())

  state        RequestState @default(PENDING)
  decidedById  String?
  decidedAt    DateTime?
  decisionNote String?

  @@index([state])
}

/// A locked month cannot be edited. To change a figure in one, the employee's
/// manager raises one of these with a reason; HR approves or declines, also
/// with a reason. An approved request reopens that one month for that one
/// employee — see lib/corrections.ts, which is the only place that decides
/// whether a reopen is currently in force — and is marked resolved the moment
/// the corrected month is resubmitted, which re-locks it.
///
/// Scoped to (employee, cycle) rather than to a single MonthlyEntry: a
/// correction reopens the month, and the manager then re-enters whichever
/// figures were wrong through the normal form.
model CorrectionRequest {
  id String @id @default(cuid())

  employeeId String
  employee   Employee @relation("CorrectionSubject", fields: [employeeId], references: [id], onDelete: Cascade)
  cycleId    String
  cycle      Cycle    @relation(fields: [cycleId], references: [id])

  /// Why the month needs reopening. Required of the manager.
  reason String

  raisedById String
  raisedAt   DateTime @default(now())

  state RequestState @default(PENDING)
  /// HR's reason for approving or declining. Required either way.
  decisionNote String?
  decidedById  String?
  decidedAt    DateTime?

  /// Set when the reopened month is resubmitted, which ends the reopen. A row
  /// with state APPROVED and resolvedAt null is what makes a month writable.
  resolvedAt DateTime?

  @@index([state])
  @@index([employeeId, cycleId])
}

// ---------------------------------------------------------------------------
// Spreadsheet route and audit trail
// ---------------------------------------------------------------------------

model UploadBatch {
  id String @id @default(cuid())

  cycleId String
  cycle   Cycle  @relation(fields: [cycleId], references: [id])

  fileName      String
  uploadedById  String
  uploadedAt    DateTime @default(now())

  rowsTotal     Int @default(0)
  rowsCommitted Int @default(0)
  rowsRejected  Int @default(0)

  /// Per-row rejection reasons, kept so the error report can be re-downloaded.
  rejections Json?
  committedAt DateTime?

  @@index([cycleId])
}

/// Every write to the record. What makes a locked month evidence rather than a
/// working document.
model ActivityLog {
  id String @id @default(cuid())

  at      DateTime @default(now())
  actorId String?

  employeeId String?
  employee   Employee? @relation("ActivitySubject", fields: [employeeId], references: [id])
  cycleId    String?
  cycle      Cycle?    @relation(fields: [cycleId], references: [id])

  /// e.g. ENTRY_SAVED, MONTH_SUBMITTED, UPLOAD_COMMITTED, RATING_SUBMITTED.
  kind    String
  summary String
  meta    Json?

  @@index([at])
  @@index([employeeId])
  @@index([kind])
}
